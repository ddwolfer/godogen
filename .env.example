# Machine-local configuration. Copy to .env and fill in, or let /setup do it.
#
# .env is gitignored. Nothing here is a secret you must have -- every line is
# optional, and a blank value means "not available on this machine".
#
# Real environment variables win over this file, so a one-off override works
# without editing anything.

# --- Knowledge -------------------------------------------------------------
# The Multi-knowledgeGraph checkout. Leave blank to search, in order:
#   <godogen>/kg, <godogen>/../kg, ~/.godogen/kg
# Set it and get it wrong and publish will say so rather than quietly using
# a different installation.
GODOGEN_KG_HOME=

# --- Engine ----------------------------------------------------------------
# Only needed when godot is not on PATH.
GODOT_PATH=

# --- Asset backends --------------------------------------------------------
# One choice per kind, because they are independent: procedural models in
# Blender alongside cloud image generation is a perfectly normal setup.
#
# Local backends cost nothing per call and produce the same output twice.
# Cloud backends cost real money per call and drift between batches.

# blender  procedural modelling, free, reproducible, needs Blender
# tripo3d  image-to-3D, ~30-60c per model, needs TRIPO3D_API_KEY
# none     no 3D generation
ASSET_3D=blender

# comfyui  local diffusion, free, needs a GPU and a running ComfyUI
# gemini   precise prompt following, 5-15c per image, needs GOOGLE_API_KEY
# grok     fast and loose, 2c per image, needs XAI_API_KEY
# none     no image generation
ASSET_2D=comfyui

# ace   ACE Studio -- generates BGM and SFX locally, free, and keeps a library
#       that carries across projects. Reuse before generating.
# none  no audio
ASSET_AUDIO=ace

# --- Local services --------------------------------------------------------
# Only read when the matching backend above is selected.
BLENDER_PATH=
COMFYUI_URL=http://127.0.0.1:8188
# ACE Studio. Leave blank to search <godogen>/ACE_Studio, ../ACE_Studio and
# ~/.godogen/ACE_Studio. Wired as an MCP server, so the agent gets its tools
# directly; SFX_ENDPOINT is only for the standalone script path.
ACE_STUDIO_HOME=
SFX_ENDPOINT=http://127.0.0.1:8002/generate

# --- Cloud keys ------------------------------------------------------------
# Only read when a cloud backend above is selected. Every call costs money.
GOOGLE_API_KEY=
XAI_API_KEY=
TRIPO3D_API_KEY=
